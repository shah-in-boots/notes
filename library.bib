  author = {Patrono, Carlo and Morais, Joao and Baigent, Colin and Collet, Jean Philippe and Fitzgerald, Desmond and Halvorsen, Sigrun and Rocca, Bianca and Siegbahn, Agneta and Storey, Robert F. and Vilahur, Gemma},
