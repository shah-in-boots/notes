  author = {Iranpour, Pooya and Helmy, Mohammad and Choi, Joon-Il and Ward, Garrett and Yang, Albert and Goodwin, Scott C and Houshyar, Roozbeh and Lall, Chandana},
  date = {2015},
  journaltitle = {Ultrasonography},
  volume = {35},
