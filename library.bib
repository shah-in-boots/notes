@article{ZekiAlHazzouri2018c,
  title = {Heart {{Rate Variability}} and {{Cognitive Function}} in {{Middle-Age Adults}}: {{The Coronary Artery Risk Development}} in {{Young Adults}}},
  author = {Zeki Al Hazzouri, Adina and Elfassy, Tali and Carnethon, Mercedes R and Lloyd-Jones, Donald M and Yaffe, Kristine},
  date = {2018},
