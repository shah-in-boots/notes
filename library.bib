@article{Waddingham2021,
  title = {Fusion {{Pacing}} with {{Biventricular}}, {{Left Ventricular-only}} and {{Multipoint Pacing}} in {{Cardiac Resynchronisation Therapy}}: {{Latest Evidence}} and {{Strategies}} for {{Use}}},
  shorttitle = {Fusion {{Pacing}} with {{Biventricular}}, {{Left Ventricular-only}} and {{Multipoint Pacing}} in {{Cardiac Resynchronisation Therapy}}},
  author = {Waddingham, Peter H and Lambiase, Pier and Muthumala, Amal and Rowland, Edward and Chow, Anthony WC},
  date = {2021-07},
  journaltitle = {Arrhythmia \& Electrophysiology Review},
  shortjournal = {Arrhythmia Electrophysiol. Rev.},
  volume = {10},
