@article{poo2001,
  title = {Neurotrophins as Synaptic Modulators},
  author = {Poo, M.},
  date = {2001},
  journaltitle = {Nature Reviews Neuroscience},
  shortjournal = {Nat. Rev. Neurosci.},
  volume = {2},
  number = {1},
