@article{Malliani1983,
  title = {Cardiovascular Reflexes Mediated by Sympathetic Afferent Fibers.},
  author = {Malliani, Alberto and Pagani, Massimo and Pizzinelli, Paolo and Furlan, Raffaello and Guzzetti, Stefano},
