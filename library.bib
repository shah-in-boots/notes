@article{Leong2024,
  title = {Effects of {{Implantable Cardioverter-Defibrillator Leads}} on the {{Tricuspid Valve}} and {{Right Ventricle}}},
  author = {Leong, Darryl P. and Dokainish, Hisham and Mondésert, Blandine and Cavalli, Germano and Khetan, Aditya and Cirne, Filipe and Baro Vila, Rocio and Klimis, Harry and De Jesus, Tais Araujo and AlGhasab, Naif Saad and Akbari, Vahid and Suliman, Asem and Eltebi, Osama and Almhri, Ali and Ferdous, Tahsin and Djuric, Angie and Bashir, Jamil and Krahn, Andrew D. and Exner, Derek V. and Philippon, François and Birne, David H. and Joza, Jacqueline and Healey, Jeff S.},
  date = {2024-09},
  journaltitle = {JACC: Clinical Electrophysiology},
  shortjournal = {JACC Clin. Electrophysiol.},
  volume = {10},
  number = {9},
  pages = {2088--2096},
  issn = {2405500X},
  doi = {10.1016/j.jacep.2024.04.034},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S2405500X24003694},
  urldate = {2025-02-15},
  abstract = {BACKGROUND There are no randomized data to inform the extent to which transvenous cardiac leads cause tricuspid regurgitation (TR). OBJECTIVES This study sought to determine the effect of a transvenous implantable cardioverter-defibrillator (TV-ICD) on TR severity, and secondarily, on right ventricular (RV) size and function. METHODS We evaluated TR severity before and 6 months after implantable cardioverter-defibrillator insertion in a post hoc analysis of adults randomized to receive a transvenous (n ¼ 252) or subcutaneous implantable cardioverterdefibrillator (S-ICD) (n ¼ 251) device. TR and RV size and systolic function were assessed by echocardiographic images analyzed in a core laboratory. RESULTS At baseline, at least mild TR was present in 30\% of individuals. At 6 months, the proportion of participants with any TR in the TV-ICD group was 42\% vs 19\% in the S-ICD group (P {$<$} 0.001). The proportion with moderate or severe TR was 7\% in the TV-ICD group vs 2\% in the S-ICD group (P ¼ 0.021). At 6 months, the OR of at least 1 grade worsening of TR in the TV-ICD group as compared with the S-ICD group was 7.2 (95\% CI: 3.3-15.8; P {$<$} 0.001). There were no differences between groups with respect to RV size or systolic function. CONCLUSIONS Six months following TV-ICD insertion, there was a 7-fold increase in the risk of at least 1 grade worsening of TR, with 7\% of individuals having TR that was moderate or severe. There was no detectable difference in RV size or function; however, longer follow-up is needed. (JACC Clin Electrophysiol. 2024;10:2088–2096) © 2024 The Authors. Published by Elsevier on behalf of the American College of Cardiology Foundation. This is an open access article under the CC BY license (http://creativecommons.org/licenses/by/4.0/).},
  langid = {english},
  file = {/Users/asshah4/Drive/articles/Leong et al. - 2024 - Effects of Implantable Cardioverter-Defibrillator Leads on the Tricuspid Valve and Right Ventricle.pdf}
}

