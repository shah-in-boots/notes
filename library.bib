@article{Lai2014,
  title = {Adaptive Choice of Patient Subgroup for Comparing Two Treatments},
  author = {Lai, Tze Leung and Lavori, Philip W and Liao, Olivia Yueh Wen},
  date = {2014-11},
  journaltitle = {Contemporary Clinical Trials},
  shortjournal = {Contemp. Clin. Trials},
  volume = {39},
  number = {2},
  eprint = {25205644},
  eprinttype = {pubmed},
  pages = {191--200},
  issn = {15592030},
  doi = {10.1016/j.cct.2014.09.001},
  url = {http://linkinghub.elsevier.com/retrieve/pii/S1551714414001311},
  urldate = {2018-03-17},
  abstract = {This paper is motivated by a randomized controlled trial to compare an endovascular procedure with conventional medical treatment for stroke patients, in which the endovascular procedure may be effective only in a subgroup of patients. Since the subgroup is not known at the design stage but can be learned statistically from the data collected during the course of the trial, we develop a novel group sequential design that incorporates adaptive choice of the patient subgroup among several possibilities which include the entire patient population as a choice. We define the type I and type II errors of a test in this design and show how a prescribed type I error can be maintained by using the closed testing principle in multiple testing. We also show how asymptotically optimal tests can be constructed by using generalized likelihood ratio statistics for parametric problems and analogous standardized or Studentized statistics for nonparametric tests such as Wilcoxon's rank sum test commonly used for treatment comparison in stroke patients.},
  isbn = {1551-7144},
  keywords = {unread}
}

