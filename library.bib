@article{Olesen2005,
  title = {Statistical Analysis of the {{DIAMOND MI}} Study by the Multipole Method},
  author = {Olesen, R. M. and Bloch Thomsen, P. E. and Saermark, K. and Glikson, M. and Feldman, S. and Lewkowicz, M. and Levitan, J.},
  date = {2005-10-01},
