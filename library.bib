}

@article{Waldo1995,
  title = {Survival with Oral D-{{Sotalol}} in Patients with Left Ventricular Dysfunction after Myocardial Infarction: {{Rationale}}, Design, and Methods (the {{SWORD}} Trial)},
  author = {Waldo, Albert L. and Camm, A. John and {deRuyter}, H. and Friedman, Peter L. and MacNeil, Daniel J. and Pitt, Bertram and Pratt, Craig M. and Rodda, Bruce E. and Schwartz, Peter J. and {The SWORD Investigators}},
  date = {1995-05-15},
