@article{Biso2017,
  title = {A {{Review}} of {{Neurogenic Stunned Myocardium}}},
  author = {Biso, Sylvia and Wongrakpanich, Supakanya and Agrawal, Akanksha and Yadlapati, Sujani and Kishlyansky, Marina and Figueredo, Vincent},
  date = {2017},
  journaltitle = {Cardiovascular Psychiatry and Neurology},
  shortjournal = {Cardiovasc. Psychiatry Neurol.},
  volume = {2017},
  publisher = {Hindawi Limited},
  issn = {20900171},
  doi = {10.1155/2017/5842182},
  url = {/pmc/articles/PMC5569748/?report=abstract},
  urldate = {2020-09-23},
  abstract = {Neurologic stunned myocardium (NSM) is a phenomenon where neurologic events give rise to cardiac abnormalities. Neurologic events like stroke and seizures cause sympathetic storm and autonomic dysregulation that result in myocardial injury. The clinical presentation can involve troponin elevation, left ventricular dysfunction, and ECG changes. These findings are similar to Takotsubo cardiomyopathy and acute coronary syndrome. It is difficult to distinguish NSM from acute coronary syndrome based on clinical presentation alone. Because of this difficulty, a patient with NSM who is at high risk for coronary heart disease may undergo cardiac catheterization to rule out coronary artery disease. The objective of this review of literature is to enhance physician's awareness of NSM and its features to help tailor management according to the patient's clinical profile.},
  keywords = {unread},
  file = {/Users/asshah4/Drive/articles/Biso et al_2017_A Review of Neurogenic Stunned Myocardium.pdf}
}

@article{Bjornson2024,
  title = {Lipoprotein(a) {{Is Markedly More Atherogenic Than LDL}}: {{An Apolipoprotein B-Based Genetic Analysis}}},
  shorttitle = {Lipoprotein(a) {{Is Markedly More Atherogenic Than LDL}}},
  author = {Björnson, Elias and Adiels, Martin and Taskinen, Marja-Riitta and Burgess, Stephen and Chapman, M. John and Packard, Chris J. and Borén, Jan},
  date = {2024-01-23},
  journaltitle = {Journal of the American College of Cardiology},
  shortjournal = {J. Am. Coll. Cardiol.},
  volume = {83},
  number = {3},
  pages = {385--395},
  issn = {0735-1097},
  doi = {10.1016/j.jacc.2023.10.039},
  url = {https://www.sciencedirect.com/science/article/pii/S0735109723080713},
  urldate = {2024-02-08},
  abstract = {Background Lipoprotein(a) (Lp(a)) is recognized as a causal factor for coronary heart disease (CHD) but its atherogenicity relative to that of low-density lipoprotein (LDL) on a per-particle basis is indeterminate. Objectives The authors addressed this issue in a genetic analysis based on the fact that Lp(a) and LDL both contain 1~apolipoprotein B (apoB) per particle. Methods Genome-wide association studies using the UK Biobank population identified 2 clusters of single nucleotide polymorphisms: one comprising 107 variants linked to Lp(a) mass concentration, the other with 143 variants linked to LDL concentration. In these Lp(a) and LDL clusters, the relationship of genetically predicted variation in apoB with CHD risk was assessed. Results The Mendelian randomization-derived OR for CHD for a 50~nmol/L higher Lp(a)-apoB was 1.28 (95\%~CI: 1.24-1.33) compared with 1.04 (95\%~CI: 1.03-1.05) for the same increment in LDL-apoB. Likewise, use of polygenic scores to rank subjects according to difference in Lp(a)-apoB vs difference in LDL-apoB revealed a greater HR for CHD per 50~nmol/L apoB for the Lp(a) cluster (1.47; 95\%~CI: 1.36-1.58) compared with the LDL cluster (1.04; 95\%~CI: 1.02-1.05). From these data, we estimate that the atherogenicity of Lp(a) is approximately 6-fold (point estimate of 6.6; 95\%~CI: 5.1-8.8) greater than that of LDL on a per-particle basis. Conclusions We conclude that the atherogenicity of Lp(a) (CHD risk quotient per unit increase in particle number) is substantially greater than that of LDL. Therefore, Lp(a) represents a key target for drug-based intervention in a significant proportion of the at-risk population.},
  file = {/Users/asshah4/Drive/articles/Björnson et al_2024_Lipoprotein(a) Is Markedly More Atherogenic Than LDL SUPPLEMENT.pdf;/Users/asshah4/Drive/articles/Björnson et al_2024_Lipoprotein(a) Is Markedly More Atherogenic Than LDL.pdf;/Users/asshah4/Zotero/storage/YFMM8D8Z/S0735109723080713.html}
}

@article{Blackwell2022,
  title = {Animal {{Models}} to {{Study Cardiac Arrhythmias}}},
  author = {Blackwell, Daniel J. and Schmeckpeper, Jeffrey and Knollmann, Bjorn C.},
  date = {2022-06-10},
  journaltitle = {Circulation Research},
  shortjournal = {Circ. Res.},
  volume = {130},
  number = {12},
  eprint = {35679367},
  eprinttype = {pubmed},
  pages = {1926--1964},
