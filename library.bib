@article{Kar2021,
  title = {Primary {{Outcome Evaluation}} of a {{Next-Generation Left Atrial Appendage Closure Device}}: {{Results From}} the {{PINNACLE FLX Trial}}},
  shorttitle = {Primary {{Outcome Evaluation}} of a {{Next-Generation Left Atrial Appendage Closure Device}}},
  author = {Kar, Saibal and Doshi, Shephal K. and Sadhu, Ashish and Horton, Rodney and Osorio, Jose and Ellis, Christopher and Stone, James and Shah, Manish and Dukkipati, Srinivas R. and Adler, Stuart and Nair, Devi G. and Kim, Jamie and Wazni, Oussama and Price, Mathew J. and Asch, Federico M. and Holmes, David R. and Shipley, Robert D. and Gordon, Nicole T. and Allocco, Dominic J. and Reddy, Vivek Y. and {PINNACLE FLX Investigators}},
