@article{Ribeil2017,
  title = {Gene {{Therapy}} in a {{Patient}} with {{Sickle Cell Disease}}},
  author = {Ribeil, Jean-Antoine and Hacein-Bey-Abina, Salima and Payen, Emmanuel and Magnani, Alessandra and Semeraro, Michaela and Magrin, Elisa and Caccavelli, Laure and Neven, Benedicte and Bourget, Philippe and El Nemer, Wassim and Bartolucci, Pablo and Weber, Leslie and Puy, Hervé and Meritet, Jean-François and Grevent, David and Beuzard, Yves and Chrétien, Stany and Lefebvre, Thibaud and Ross, Robert W. and Negre, Olivier and Veres, Gabor and Sandler, Laura and Soni, Sandeep and family=Montalembert, given=Mariane, prefix=de, useprefix=true and Blanche, Stéphane and Leboulch, Philippe and Cavazzana, Marina},
  date = {2017},
  journaltitle = {New England Journal of Medicine},
  shortjournal = {N. Engl. J. Med.},
  volume = {376},
