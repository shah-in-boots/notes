@article{Sharma2016,
  title = {Repetitive Nonreentrant Ventriculoatrial Synchrony: {{An}} Underrecognized Cause of Pacemaker-Related Arrhythmia},
  shorttitle = {Repetitive Nonreentrant Ventriculoatrial Synchrony},
  author = {Sharma, Parikshit S. and Kaszala, Karoly and Tan, Alex Y. and Koneru, Jayanthi N. and Shepard, Richard and Ellenbogen, Kenneth A. and Huizar, Jose F.},
  date = {2016-08},
  journaltitle = {Heart Rhythm},
  volume = {13},
  number = {8},
  eprint = {27050909},
  eprinttype = {pubmed},
  pages = {1739--1747},
  issn = {1556-3871},
  doi = {10.1016/j.hrthm.2016.04.002},
  abstract = {Similar to endless loop tachycardia (ELT), repetitive nonreentrant ventriculoatrial synchrony (RNRVAS) is a ventriculoatrial (VA) synchrony pacemaker-mediated arrhythmia. RNRVAS was first described in 1990 and can only occur in the presence of retrograde VA conduction and dual-chamber or cardiac resynchronization devices with tracking (P-synchronous ventricular pacing such as DDD, DDDR) or nontracking pacing modes that allow AV-sequential pacing (DDI, DDIR). RNRVAS is promoted by (1) high lower rate limit or any feature that allows rapid pacing, (2) long AV intervals, or (3) long postventricular atrial refractory period (PVARP). In contrast to ELT, RNRVAS is a less well-recognized form of pacemaker-mediated arrhythmia; thus, unlike ELT, there are no specific device algorithms to prevent, recognize, and terminate RNRVAS. However, RNRVAS has been recently shown to occur frequently. We present a series of cases, some of which were found fortuitously. Owing to its clinical implications, we propose that algorithms should be developed to prevent, identify, and terminate RNRVAS.},
  langid = {english},
  keywords = {Dual-chamber pacemaker,Electrocardiography,Equipment Failure,Heart Atria,Heart Conduction System,Humans,Mode switching,Pacemaker Artificial,Pacemaker syndrome,Pacemaker-mediated arrhythmia,Repetitive nonreentrant VA synchrony,Retrograde VA conduction,Tachycardia},
  file = {/Users/asshah4/Drive/articles/Sharma et al_2016_Repetitive nonreentrant ventriculoatrial synchrony.pdf}
}

@article{Sharpe1988a,
