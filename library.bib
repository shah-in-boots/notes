@article{Sposato2020,
  title = {Post-{{Stroke Cardiovascular Complications}} and {{Neurogenic Cardiac Injury}}: {{JACC State-of-the-Art Review}}},
  author = {Sposato, Luciano A. and Hilz, Max J. and Aspberg, Sara and Murthy, Santosh B. and Bahit, M. Cecilia and Hsieh, Cheng Yang and Sheppard, Mary N. and Scheitz, Jan F.},
  date = {2020-12-08},
  journaltitle = {Journal of the American College of Cardiology},
