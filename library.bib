@article{Milevski2022,
  title = {Anabolic Steroid Misuse Is an Important Reversible Cause of Cardiomyopathy: A Case Report},
  shorttitle = {Anabolic Steroid Misuse Is an Important Reversible Cause of Cardiomyopathy},
  author = {Milevski, Stefan V and Sawyer, Matthew and La Gerche, Andre and Paratz, Elizabeth},
  date = {2022-07-01},
  journaltitle = {European Heart Journal - Case Reports},
  shortjournal = {Eur. Heart J. - Case Rep.},
  volume = {6},
  number = {7},
  pages = {ytac271},
  issn = {2514-2119},
  doi = {10.1093/ehjcr/ytac271},
  url = {https://doi.org/10.1093/ehjcr/ytac271},
  urldate = {2024-04-08},
  abstract = {Anabolic steroid misuse is very common and has been linked to the development of a severe cardiomyopathy, arrhythmias, and sudden death.A 46-year-old miner presented to hospital with subacute dyspnoea and palpitations. Investigations revealed atrial fibrillation and a severe dilated cardiomyopathy with left ventricular ejection fraction of 12\%. The patient had a history of longstanding exogenous testosterone administration. Haematological investigations demonstrated a marked polycythaemia, with haematocrit of 0.60\>L/L (normal 0.40–0.54\>L/L). Hormonal investigations revealed an elevated testosterone level of 46.4\>nmol/L (normal 8.0–30.0\>nmol/L) and suppressed luteinizing and follicle-stimulating hormones, consistent with excess testosterone use. The patient was referred to the endocrinology specialty team for support with ceasing excess testosterone use, while commencing guideline-directed heart failure therapy. At 6 months of follow-up, the patient’s left ventricular ejection fraction had normalized and he was asymptomatic. Biochemical indicators of testosterone excess had also normalized.Anabolic steroids are widely misused, particularly among young and middle-aged males. Cardiovascular complications include a potentially reversible severe cardiomyopathy, accelerated coronary disease, dyslipidaemia, arrhythmias, and sudden death. It is important to identify a history of anabolic steroid misuse when investigating cardiomyopathy and be alert for indicators such as polycythaemia. Cessation of anabolic steroid misuse may lead to complete reversal of cardiomyopathy but should be undertaken in close partnership with the patient and endocrinologists.},
  keywords = {unread},
  file = {/Users/asshah4/Drive/articles/Milevski et al_2022_Anabolic steroid misuse is an important reversible cause of cardiomyopathy.pdf;/Users/asshah4/Zotero/storage/RYQQZ49Z/6627290.html}
}

