  author = {Orso, Daniele and Paoli, Irene and Piani, Tommaso and Cilenti, Francesco L and Cristiani, Lorenzo and Guglielmo, Nicola},
  date = {2018-01-17},
  journaltitle = {Journal of Intensive Care Medicine},
