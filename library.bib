  doi = {10.15420/aer.2022.37},
  url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9945432/},
  urldate = {2025-01-24},
  abstract = {As the most common sustained arrhythmia, AF is a complex clinical entity which remains a difficult condition to durably treat in the majority of patients. Over the past few decades, the management of AF has focused mainly on pulmonary vein triggers for its initiation and perpetuation. It is well known that the autonomic nervous system (ANS) has a significant role in the milieu predisposing to the triggers, perpetuators and substrate for AF. Neuromodulation of ANS – ganglionated plexus ablation, vein of Marshall ethanol infusion, transcutaneous tragal stimulation, renal nerve denervation, stellate ganglion block and baroreceptor stimulation – constitute an emerging therapeutic approach for AF. The purpose of this review is to summarise and critically appraise the currently available evidence for neuromodulation modalities in AF.},
