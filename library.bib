@article{Jolfayi2024,
  title = {Exploring {{TTN}} Variants as Genetic Insights into Cardiomyopathy Pathogenesis and Potential Emerging Clues to Molecular Mechanisms in Cardiomyopathies},
  author = {Jolfayi, Amir Ghaffari and Kohansal, Erfan and Ghasemi, Serwa and Naderi, Niloofar and Hesami, Mahshid and MozafaryBazargany, MohammadHossein and Moghadam, Maryam Hosseini and Fazelifar, Amir Farjam and Maleki, Majid and Kalayinia, Samira},
