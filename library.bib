  title = {Cardiac Sympathetic Denervation 100 Years Later: {{Jonnesco}} Would Have Never Believed It},
  author = {Schwartz, Peter J and De Ferrari, Gaetano M and Pugliese, Luigi},
  date = {2017},
  journaltitle = {International Journal of Cardiology},
  shortjournal = {Int. J. Cardiol.},
  volume = {237},
  eprint = {28318666},
  eprinttype = {pubmed},
  pages = {25--28},
