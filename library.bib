@article{Holda2015,
  title = {Anatomical Variations of the Coronary Sinus Valve ({{Thebesian}} Valve): Implications for Electrocardiological Procedures},
  shorttitle = {Anatomical Variations of the Coronary Sinus Valve ({{Thebesian}} Valve)},
  author = {Hołda, Mateusz K. and Klimek-Piotrowska, Wiesława and Koziej, Mateusz and Mazur, Małgorzata},
  date = {2015-06-01},
  journaltitle = {EP Europace},
  shortjournal = {EP Eur.},
  volume = {17},
  number = {6},
  pages = {921--927},
  issn = {1099-5129},
  doi = {10.1093/europace/euu397},
  url = {https://doi.org/10.1093/europace/euu397},
  urldate = {2025-02-19},
  abstract = {The Thebesian valve (TV) can be a significant obstacle to coronary sinus (CS) cannulation. The aim of this study was to evaluate the characteristic features of the CS valve—TV anatomy. In particular, emphasis was placed on identifying specific structures of the TV that could potentially complicate CS cannulation.We examined 273 autopsied human hearts. The height of the TV and the diameter of the CS were measured. The valves were classified according to their shape into five types: remnant, semilunar, fold, cord, and mesh and fenestrated. The mean transverse CS ostium (CSO) diameter was 12.2 ± 3.5 mm. The TV was present in 224 (82.1\%) cases. The most common type of TV was semilunar: 32.6\%; followed by remnant: 25.5\%; fold: 17.4\%; cord: 14.3\%; and lastly mesh and fenestrated: 10.3\%. The mean TV height for remnant–semilunar–fold types was 5.8 ± 3.0 mm. In seven cases, the present TV (2.6\%) covered the entire orifice of the CS. Hearts with larger CSO diameter had lower TV height (P \&lt; 0.001).We propose a new classification of the TV shapes based on the largest sample to date. We assessed that only in 2.6\% of all 273 cases the presence of an obstructive TV can cause unsuccessful cannulation. The height of the TV was inversely correlated to the CSO diameter (r = −0.33; P \&lt; 0.001).},
  keywords = {unread},
  file = {/Users/asshah4/Drive/articles/Hołda et al. - 2015 - Anatomical variations of the coronary sinus valve (Thebesian valve) implications for electrocardiological procedures.pdf}
}

