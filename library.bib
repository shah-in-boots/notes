  doi = {10.4103/IJCIIS.IJCIIS_118_20},
  url = {/pmc/articles/PMC8547684/},
  urldate = {2022-11-23},
  abstract = {Supraventricular tachycardia is one the most frequent cardiac arrhythmias seen in patients, with AVNRT being the most common subtype. Two subgroups of AVNRT have been reported, that of typical and atypical. 'Frog Sign,' long considered a classic physical exam sign, albeit rare, is associated with typical AVNRT. We present a case of a patient who presented with frog sign and ultimately was determined to have AVNRT. Knowledge of 'frog' sign aids clinical diagnosis and correct treatment.},
