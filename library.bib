  pages = {2563--2572},
  issn = {0735-1097},
  doi = {10.1016/j.jacc.2021.04.110},
  url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8688256/},
  urldate = {2023-11-09},
  abstract = {Atrial fibrillation (AF) affects at least 60 million individuals globally, and is associated with substantial impacts on morbidity, mortality, and health care expenditure. In this review, we focus on how race and ethnicity influence AF epidemiology, risk prediction, treatment, and outcomes, and identify knowledge gaps in these areas. Most AF studies have predominantly included White populations with an underrepresentation of racial and ethnic groups including, but not limited to, Black, Hispanic, and Indigenous individuals. Enhancement and implementation of AF risk prediction, prevention, and management call for studies that will gather accurate race-based epidemiological data and evaluate social determinants and genetic factors in the context of multiple races and ethnicities. Available studies highlight inequities in access to treatment as well as outcomes between White individuals and persons of other races/ethnicities. These will need to be addressed by a renewed emphasis on structural and social determinants of health that contribute to AF., In this review, we focus on how race and ethnicity influence AF epidemiology, risk prediction, treatment, and outcomes, and identify knowledge gaps in these areas. Most AF studies have predominantly included White populations with an underrepresentation of other racial and ethnic groups. There is a critical need for studies that will gather accurate race-based epidemiological and genetic data. Available studies highlight sizeable inequities in access to treatment as well as outcomes between Whites individuals and persons of other races/ethnicities. These will need to be addressed by a renewed emphasis on structural and social determinants of health that contribute to AF.},
  pmcid = {PMC8688256},
  keywords = {unread},
  file = {/Users/asshah4/Drive/articles/Norby et al_2021_Racial and Ethnic Considerations in Patients with Atrial Fibrillation.pdf}
