@article{Hayashi2015,
  title = {The {{Spectrum}} of {{Epidemiology Underlying Sudden Cardiac Death}}},
  author = {Hayashi, Meiso and Shimizu, Wataru and Albert, Christine M.},
  date = {2015-06-05},
  journaltitle = {Circulation Research},
  shortjournal = {Circ. Res.},
  volume = {116},
  number = {12},
  eprint = {26044246},
